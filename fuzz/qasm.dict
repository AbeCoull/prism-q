"#pragma braket noise bit_flip(0.1) q[0]"
"#pragma braket verbatim"
"#pragma braket"
"h q[0];"
"cx q[0], q[1];"
"c[0] = measure q[0];"
"measure q -> c;"
"if (c[0]) x q[1];"
"for int i in [0:3] { h q[i]; }"
"gate g(t) a, b { rx(t) a; cx a, b; }"
"def f(qubit a, float t) { rz(t) a; }"
